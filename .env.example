# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ─── Postgres (matches docker-compose.yml) ───────────────────────────────────
DATABASE_URL=postgres://sales:sales@localhost:5544/sales_reps

# ─── Redis (matches docker-compose.yml) ──────────────────────────────────────
REDIS_URL=redis://localhost:6399

# ─── Auth (better-auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-please-generate-a-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# Initial admin user created by `npm run db:seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123

# ─── Dial (https://getdial.ai) ───────────────────────────────────────────────
# API key + the number to call from. Defaults below match the local `dial` CLI
# onboarding; override per environment.
DIAL_API_BASE=https://getdial.ai
DIAL_API_KEY=sk_live_...
DIAL_FROM_NUMBER_ID=

# Optional webhook signing secret (if you register a Dial webhook -> /api/webhooks/dial)
DIAL_WEBHOOK_SECRET=

# ─── Follow-up analyzer ──────────────────────────────────────────────────────
# "heuristic" (default, no external calls), "groq" (cheap LLM, recommended), or
# "claude". An AI analyzer activates only when its API key is also set.
FOLLOWUP_ANALYZER=heuristic

# Groq (OpenAI-compatible, fast + cheap) — set key and FOLLOWUP_ANALYZER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (alternative AI analyzer)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
